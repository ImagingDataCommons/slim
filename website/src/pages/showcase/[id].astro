---
import { ArrowLeft, ArrowUpRight } from 'lucide-react'
import { getCollection, render, type CollectionEntry } from 'astro:content'
import ExampleCard from '../../components/ExampleCard.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getExample, type IdcExample } from '../../lib/examples'

export async function getStaticPaths() {
  const entries = await getCollection('showcase')
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }))
}

interface Props {
  entry: CollectionEntry<'showcase'>
}

const { entry } = Astro.props
const { Content } = await render(entry)
const { title, organization, summary, url, tags, stats, links } = entry.data
const examples = entry.data.examples
  .map(getExample)
  .filter((example): example is IdcExample => example?.available === true)
---

<BaseLayout title={title} description={summary}>
  <article class="container-site py-16">
    <a href="/showcase/" class="inline-flex items-center gap-1 text-13 text-ink-muted hover:text-ink">
      <ArrowLeft className="size-3.5" aria-hidden="true" />
      Showcase
    </a>
    <header class="mt-6 flex flex-col gap-4">
      <p class="eyebrow">{organization}</p>
      <h1 class="text-4xl leading-tight sm:text-5xl">{title}</h1>
      <p class="max-w-3xl text-lead text-ink-secondary">{summary}</p>
      <div class="flex flex-wrap gap-1.5">{tags.map((tag) => <span class="chip">{tag}</span>)}</div>
    </header>

    {
      stats.length > 0 && (
        <dl class="mt-10 grid gap-4 sm:grid-cols-3">
          {stats.map((stat) => (
            <div class="card flex flex-col-reverse gap-1 p-5">
              <dt class="text-13 text-ink-muted">{stat.label}</dt>
              <dd class="font-mono text-3xl font-medium text-ink">{stat.value}</dd>
            </div>
          ))}
        </dl>
      )
    }

    <div class="mt-14 grid gap-12 lg:grid-cols-[minmax(0,1fr)_300px]">
      <div class="prose-slim">
        <Content />
      </div>
      <aside class="flex flex-col gap-6">
        <div class="card p-5">
          <h2 class="eyebrow">Links</h2>
          <ul class="mt-3 flex flex-col gap-2 text-sm">
            <li>
              <a href={url} target="_blank" rel="noopener" class="inline-flex items-center gap-1 text-primary hover:underline">
                Website
                <ArrowUpRight className="size-3.5" aria-hidden="true" />
              </a>
            </li>
            {
              links.map((link) => (
                <li>
                  <a href={link.href} target="_blank" rel="noopener" class="inline-flex items-center gap-1 text-primary hover:underline">
                    {link.label}
                    <ArrowUpRight className="size-3.5" aria-hidden="true" />
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </aside>
    </div>

    {
      examples.length > 0 && (
        <section class="mt-16">
          <h2 class="text-2xl">Open the data in Slim</h2>
          <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {examples.map((example) => <ExampleCard example={example} />)}
          </ul>
        </section>
      )
    }
  </article>
</BaseLayout>
