{
  "name": "slim",
  "version": "0.46.10",
  "private": true,
  "author": "ImagingDataCommons",
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b",
  "scripts": {
    "start": "rm -rf ./node_modules/.cache/default-development && ./scripts/set-git-env.sh craco start",
    "dev": "pnpm run start",
    "typecheck": "tsc --noEmit",
    "build": "./scripts/set-git-env.sh craco build",
    "build:firebase": "REACT_APP_CONFIG=gcp PUBLIC_URL=/ ./scripts/set-git-env.sh craco build",
    "lint": "biome check .",
    "lint:strict": "eslint --config .eslintrc.strict.cjs src/",
    "lint:fix": "biome check --write --unsafe .",
    "fmt": "biome format --write .",
    "test": "TZ=UTC craco test --watchAll=false",
    "predeploy": "REACT_APP_CONFIG=demo PUBLIC_URL='https://imagingdatacommons.github.io/slim/' ./scripts/set-git-env.sh craco build",
    "deploy": "gh-pages -d build",
    "clean": "rm -rf ./build ./node_modules",
    "prepare": "husky"
  },
  "browserslist": {
    "production": [
      "supports webgl2 and supports es6-module-dynamic-import",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-table": "8.20.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dcmjs": "^0.35.0",
    "detect-browser": "^5.2.1",
    "dicom-microscopy-viewer": "^0.48.27",
    "dicomweb-client": "0.10.3",
    "lucide-react": "^1.49.0",
    "oidc-client-ts": "^3.5.0",
    "ol": "^10.7.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-error-boundary": "^3.1.4",
    "react-router-dom": "^6.30.6",
    "retry": "^0.13.1",
    "tailwind-merge": "^3.7.0",
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.15.0",
    "@babel/preset-react": "^7.17.12",
    "@babel/preset-typescript": "^7.17.12",
    "@biomejs/biome": "2.4.16",
    "@craco/craco": "^6.4.0",
    "@testing-library/jest-dom": "^5.16.4",
    "@testing-library/react": "^14.0.0",
    "@types/d3-dispatch": "3.0.6",
    "@types/jest": "^27.5.2",
    "@types/lodash": "^4.17.20",
    "@types/node": "^24.19.0",
    "@types/react": "^18.0.14",
    "@types/react-dom": "^18.0.5",
    "@types/retry": "^0.12.1",
    "@types/uuid": "^8.3.0",
    "ajv": "6.12.6",
    "autoprefixer": "^10.6.1",
    "copy-webpack-plugin": "9.1.0",
    "eslint": "^8.57.0",
    "eslint-plugin-sonarjs": "^0.25.0",
    "fraction.js": "^4.3.7",
    "gh-pages": "^5.0.0",
    "husky": "^9.1.7",
    "postcss": "8.5.25",
    "react-scripts": "5.0.0",
    "tailwindcss": "3.4.16",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^6.0.3"
  }
}
